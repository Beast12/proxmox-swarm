#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: koen
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin, docker, render, video
    shell: /bin/bash
    lock_passwd: false
    passwd: ${password_hash}
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

packages:
  - qemu-guest-agent
  - curl
  - wget
  - vim
  - git
  - htop
  - net-tools
  - nfs-common

package_update: true
package_upgrade: false

mounts:
  - ["192.168.10.10:/volume1/proxmox_swarm_data", "/mnt/proxmox_swarm_data", "nfs", "defaults", "0", "0"]

runcmd:
  # Enable QEMU guest agent
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  
  # Mount NFS
  - mkdir -p /mnt/proxmox_swarm_data
  - mount -a
  
  # Install Docker
  - curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  - sh /tmp/get-docker.sh
  - usermod -aG docker koen
  
  # Install standard kernel for GPU support (background job)
  - nohup bash -c 'apt-get install -y linux-image-amd64 linux-headers-amd64 firmware-linux-nonfree && sed -i "s/^GRUB_DEFAULT=.*/GRUB_DEFAULT=0/" /etc/default/grub && update-grub && echo "i915" >> /etc/modules && shutdown -r +1' &
